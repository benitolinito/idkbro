{
  "name": "multicode",
  "version": "0.4.0",
  "private": true,
  "description": "A CLI-first collaboration layer for local coding agents.",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "dev": "npm run dev -w @multicode/cli",
    "multicode": "node packages/cli/dist/index.js",
    "relay:serve": "node packages/cli/dist/index.js relay serve",
    "setup:cli": "npm install && npm run build && npm link --workspace @multicode/cli",
    "test": "npm run build && vitest run",
    "typecheck": "tsc -b --pretty false"
  },
  "engines": {
    "node": ">=22.5"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
