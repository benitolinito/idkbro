{
  "name": "multicode-vscode",
  "displayName": "MultiCode",
  "description": "Host and join collaborative Codex or Claude sessions from VS Code.",
  "version": "0.4.8",
  "private": true,
  "publisher": "multicode",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/benitolinito/idkbro.git"
  },
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "codex",
    "claude",
    "collaboration",
    "pair programming"
  ],
  "main": "./dist/extension.js",
  "dependencies": {
    "@multicode/protocol": "0.0.0",
    "@multicode/workspace": "0.0.0",
    "markdown-it": "^14.3.0",
    "ws": "^8.18.0"
  },
  "activationEvents": [
    "onStartupFinished",
    "onCommand:multicode.host",
    "onCommand:multicode.join",
    "onCommand:multicode.openChat",
    "onCommand:multicode.sendPrompt",
    "onCommand:multicode.doctor",
    "onCommand:multicode.selectClaudeAuthentication",
    "onCommand:multicode.configureClaudeApiKey",
    "onCommand:multicode.forgetClaudeApiKey",
    "onCommand:multicode.stop",
    "onCommand:multicode.openPreview",
    "onCommand:multicode.openProposal",
    "onView:multicode.chatView"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "multicode",
          "title": "MultiCode",
          "icon": "media/multicode.svg"
        }
      ]
    },
    "views": {
      "multicode": [
        {
          "type": "webview",
          "id": "multicode.chatView",
          "name": "Shared Agent"
        }
      ]
    },
    "commands": [
      {
        "command": "multicode.openChat",
        "title": "MultiCode: Open Chat",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "multicode.host",
        "title": "MultiCode: Host Room",
        "icon": "$(broadcast)"
      },
      {
        "command": "multicode.join",
        "title": "MultiCode: Join Room",
        "icon": "$(people)"
      },
      {
        "command": "multicode.sendPrompt",
        "title": "MultiCode: Send Prompt",
        "icon": "$(send)"
      },
      {
        "command": "multicode.doctor",
        "title": "MultiCode: Check Setup"
      },
      {
        "command": "multicode.selectClaudeAuthentication",
        "title": "MultiCode: Select Claude Authentication"
      },
      {
        "command": "multicode.configureClaudeApiKey",
        "title": "MultiCode: Configure Claude API Key"
      },
      {
        "command": "multicode.forgetClaudeApiKey",
        "title": "MultiCode: Forget Claude API Key"
      },
      {
        "command": "multicode.stop",
        "title": "MultiCode: Stop or Leave Room",
        "icon": "$(debug-stop)"
      },
      {
        "command": "multicode.openProposal",
        "title": "MultiCode: Open Agent Conflict Proposal",
        "icon": "$(git-pull-request)"
      },
      {
        "command": "multicode.openPreview",
        "title": "MultiCode: Open Agent Preview (Not Merged)",
        "icon": "$(diff)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "multicode.openChat"
        },
        {
          "command": "multicode.sendPrompt",
          "when": "multicode.connected"
        },
        {
          "command": "multicode.stop",
          "when": "multicode.connected"
        },
        {
          "command": "multicode.openProposal",
          "when": "multicode.connected && multicode.hasProposal"
        },
        {
          "command": "multicode.openPreview",
          "when": "multicode.connected && multicode.hasPreview"
        }
      ]
    },
    "configuration": {
      "title": "MultiCode",
      "properties": {
        "multicode.executable": {
          "type": "string",
          "default": "multicode",
          "description": "Path to the MultiCode CLI executable. The development checkout is detected automatically."
        },
        "multicode.codexExecutable": {
          "type": "string",
          "default": "",
          "description": "Optional absolute path to the Codex executable. Leave blank to detect the official Codex extension automatically."
        },
        "multicode.defaultAgent": {
          "type": "string",
          "enum": ["codex", "claude"],
          "default": "codex",
          "description": "Agent provider preselected when hosting a room."
        },
        "multicode.experimentalClaude": {
          "type": "boolean",
          "default": false,
          "description": "Show experimental Claude support when hosting rooms. Setting defaultAgent to claude also enables it."
        },
        "multicode.claudeAuthentication": {
          "type": "string",
          "enum": ["subscription", "apiKey"],
          "enumDescriptions": [
            "Use the account signed in through the local Claude CLI.",
            "Use an Anthropic API key stored in VS Code SecretStorage."
          ],
          "default": "subscription",
          "description": "Authentication used by the local Claude host process. Subscription mode never exports or copies Claude's saved credentials."
        },
        "multicode.claudeExecutable": {
          "type": "string",
          "default": "",
          "description": "Optional absolute path to the Claude executable used by the Agent SDK."
        },
        "multicode.displayName": {
          "type": "string",
          "default": "",
          "description": "Name shown to other room participants. Leave blank to use your operating-system username."
        },
        "multicode.relayUrl": {
          "type": "string",
          "default": "wss://multicode.luisagd.com",
          "description": "WebSocket relay used when hosting or joining rooms."
        }
      }
    }
  },
  "scripts": {
    "build": "tsc -b",
    "bundle": "esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --outfile=dist/extension.js && esbuild ../../packages/cli/src/index.ts --bundle --platform=node --format=cjs --outfile=dist/multicode-cli.cjs",
    "package": "npm run bundle && vsce package --no-dependencies",
    "clean": "tsc -b --clean"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.2.0",
    "@types/vscode": "^1.96.0",
    "@vscode/vsce": "^3.6.2",
    "esbuild": "^0.25.0"
  }
}
